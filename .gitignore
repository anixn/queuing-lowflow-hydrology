# Never commit credentials or local R settings
.env
.env.local
.Renviron
.Rprofile

# Generated logs (results CSVs are committed; logs are not)
output/_*log.txt

# Python leftovers (the v1 code is on branch legacy-python)
__pycache__/
*.pyc

# Regenerable held-out prediction tables (large; reproducible by study_p1.R)
paper01/output/p1_predictions*.csv

# LaTeX/knitr build detritus (regenerable)
paper01/*.log
paper01/*.aux
paper01/*.out
paper01/*.tex
